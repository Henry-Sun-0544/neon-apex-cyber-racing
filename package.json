{
  "name": "neon-apex-cyber-racing",
  "private": true,
  "version": "1.0.0",
  "description": "Neon Apex: Cyber Racing (NA:CR) - procedural cyberpunk 3D racing game built with Vite + TypeScript + Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
